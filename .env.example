# Required: OpenRouter API key for AI chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Polygon.io (Massive) API key for real market data
# If not set, the built-in market simulator is used (recommended)
MASSIVE_API_KEY=

# Set to "true" to use mock LLM responses (no API key needed, good for testing)
LLM_MOCK=false
